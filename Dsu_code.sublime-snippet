struct dsu {
    vector<int> nodes;
    int component;
    int N;
    vector<vector<int>> top15;
    dsu(int n) : N(n) {
        nodes = vector<int>(N + 1, -1);
        component = n;
        top15.resize(N + 1);
        // initially, each vertex is in its own set; so top15 for i is just {i}
        for (int i = 1; i <= N; i++) {
            top15[i].push_back(i);
        }
    }

    // find parent or get representive component (uses path compression)
    int find_parent(int x) {
        return nodes[x] < 0 ? x : nodes[x] = find_parent(nodes[x]);
    }


    bool same_set(int a, int b) {
        return find_parent(a) == find_parent(b);
    }

    // comp(x)'s size
    int size(int x) {
        return -nodes[find_parent(x)];
    }

    // Component number
    int count() {
        return component;
    }
    vector<int> merge_top15(const vector<int>& a, const vector<int>& b) {
        vector<int> merged;
        merged.reserve(a.size() + b.size());
        int i = 0, j = 0;
        // Both a and b are sorted in descending order.
        while ((i < sz(a) || j < sz(b)) && sz(merged) < 15) {
            if (j >= sz(b) || (i < sz(a) && a[i] > b[j])) {
                merged.push_back(a[i]);
                i++;
            } else {
                merged.push_back(b[j]);
                j++;
            }
        }
        return merged;
    }
    // connects x and y
    bool unite(int x, int y) {  // union by size
        x = find_parent(x);
        y = find_parent(y);

        if (x == y)
            return false;
        if (nodes[x] > nodes[y])
            swap(x, y);

        nodes[x] += nodes[y];
        nodes[y] = x;
        top15[x] = merge_top15(top15[x], top15[y]);
        component--;
        return true;
    }

    vector<vector<int>> group() {
        vector<int> parent_buf(N + 1), group_size(N + 1);
        for (int i = 1; i <= N; i++) {
            parent_buf[i] = find_parent(i);
            group_size[parent_buf[i]]++;
        }
        vector<vector<int>> result(N + 1);
        for (int i = 1; i <= N; i++)
            result[i].reserve(group_size[i]);
        for (int i = 1; i <= N; i++)
            result[parent_buf[i]].push_back(i);
        result.erase(
            remove_if(result.begin(), result.end(),
        [&](const vector<int> &v) { return v.empty(); }),
        result.end());
        return result;
    }
    vector<int> get_members(int x) {
        int root = find_parent(x);
        vector<int> members;
        for (int i = 1; i <= N; i++) {
            if (find_parent(i) == root)
                members.push_back(i);
        }
        return members;
    }
    vector<int> get_top15(int x) {
        int root = find_parent(x);
        return top15[root];
    }
    //dsu d(n);
};
]]></content>
